GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
FRONTEND_URL=http://localhost:5173
GOOGLE_GEMINI_API_KEY=
VITE_API_URL=http://localhost:8000/api
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_BACKUP=gemini-3.1-flash-lite
GEMINI_MODEL_COMPLEX=gemini-3.8-flash
# Opcional: limite de salida de Gemini (incluye tokens de razonamiento). Por defecto 65536.
# Si un estado de cuenta lo supera, la extraccion se rechaza como truncada; nunca se usa a medias.
GEMINI_MAX_OUTPUT_TOKENS=65536
# Modelos de respaldo, en orden, si el configurado falla por un error temporal (429, 500, 502, 503, 504 o tiempo agotado).
# Si no se define, se usan estos mismos.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
PORT=8787
HOST=127.0.0.1
# Servicio SaveData (solo lo llama el backend). Valor de ejemplo:
SAVEDATA_URL=http://servidor-savedata.ejemplo/V3/Pruebas/SaveData
# Opcional: minutos entre revisiones de la extraccion automatica de Gmail (por defecto 20, minimo 1).
# NEXORA_INTERVALO_MINUTOS=20
# Almacenamiento: json (por defecto, archivos en backend/data) o db (base de datos de DATABASE_URL).
NEXORA_ALMACEN=json
# Base de datos (MySQL 8.4 / MariaDB 10.11+; portable a PostgreSQL). Sin contraseña real aquí.
# DATABASE_URL=mysql+pymysql://nexora_app:CAMBIAR@localhost:3306/nexora?charset=utf8mb4
DATABASE_URL=
# Llave Fernet para credencial_cifrada (obligatoria con NEXORA_ALMACEN=db). Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guárdala fuera del repo: si se pierde, las credenciales guardadas ya no se pueden leer.
NEXORA_LLAVE_CIFRADO=
# Extracción sin IA (modo manual, el predeterminado de cada tipo de documento; se cambia por tipo en Configuración).
# NEXORA_MODO_PREDETERMINADO=manual
# OCR opcional para PDFs escaneados: ruta de tesseract.exe si no está en el PATH, e idioma (spa).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# NEXORA_OCR_IDIOMA=spa
