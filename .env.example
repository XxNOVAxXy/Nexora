GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
FRONTEND_URL=http://localhost:5173
GOOGLE_GEMINI_API_KEY=
VITE_API_URL=http://localhost:8000/api
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_BACKUP=gemini-3.1-flash-lite
GEMINI_MODEL_COMPLEX=gemini-3.8-flash
# Opcional: limite de salida de Gemini (incluye tokens de razonamiento). Por defecto 65536.
# Si un estado de cuenta lo supera, la extraccion se rechaza como truncada; nunca se usa a medias.
GEMINI_MAX_OUTPUT_TOKENS=65536
PORT=8787
HOST=127.0.0.1
# Servicio SaveData (solo lo llama el backend). Valor de ejemplo:
SAVEDATA_URL=http://servidor-savedata.ejemplo/V3/Pruebas/SaveData
# Opcional: minutos entre revisiones de la extraccion automatica de Gmail (por defecto 20, minimo 1).
# NEXORA_INTERVALO_MINUTOS=20
